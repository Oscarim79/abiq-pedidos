{
  "name": "abiq-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "next lint",
    "deploy": "cross-env NEXT_TELEMETRY_DISABLED=1 GITHUB_PAGES=true next build && gh-pages -d out --dotfiles -m \"Publicar en GitHub Pages\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
